local Policy = (function()
__MDL_POLICY__
end)()
local Data = (function()
__MDL_DATA__
end)()
local Audio = (function()
__MDL_AUDIO__
end)()
local format = '__AUDIO_FORMAT__'
local content = '__AUDIO_CONTENT__'
local state, audio, context
local clock, next_sample = 0, 0
local last_hub, last_audio_status
local wanted, preview, preview_reported = false, false, false
local volume, fade_out = 50, 1
local active, automatic = false, true
local subscriptions, event_retry = {}, 0
local function unsubscribe()
    for _, subscription in pairs(subscriptions) do
        if type(subscription) == 'table' and type(subscription.unsubscribe) == 'function' then
            pcall(subscription.unsubscribe, subscription)
        end
    end
    subscriptions = {}
end
local option_api, definition
local option_retry, registered = 0, {}
local option_ids = {volume = 'rainie_love_mdl.volume', fade_out = 'rainie_love_mdl.fade_out_seconds',
    preview = 'rainie_love_mdl.preview', automatic = 'rainie_love_mdl.automatic'}
local function report(message)
    if context and type(context.log) == 'function' then
        context.log('[RainieLove-MDL] ' .. message)
    else
        print('[RainieLove-MDL] ' .. message)
    end
    pcall(function()
        local root = os.getenv('LOCALAPPDATA')
        if not root then return end
        local file = io.open(root .. '/MDL/Helldivers2/Logs/RainieLove-MDL.log', 'a')
        if file then file:write(string.format('%.3f %s\n', clock, message)); file:close() end
    end)
end
local function option_call(fn, ...)
    if type(fn) ~= 'function' then return nil end
    local ok, value = pcall(fn, ...)
    if ok then return value end
end
local function connect_options(ctx)
    option_retry = clock + 5
    option_api, registered = nil, {}
    local api = rawget(_G, 'ModOptionsMenu')
    if type(api) == 'table' and type(api.register_option) == 'function'
        and type(api.get) == 'function' and type(api.set) == 'function' then option_api = api end
    local specifications = {
        {key = 'preview', type = 'toggle', label = '试听', default = false,
         description = '启用或重新加载模组后需等待音频准备，当前实测约 80–90 秒。保持试听开启，准备完成后自动循环播放；关闭后淡出。'},
        {key = 'volume', type = 'slider', label = '音乐音量（%）', min = 0, max = 100, step = 5, default = 50,
         description = '0–100%，实时调整并保留播放位置。'},
        {key = 'fade_out', type = 'slider', label = '淡出时间（秒）', min = 1, max = 30, step = 1, default = 1,
         description = '条件结束后淡出，下次触发从歌曲开头播放。'},
        {key = 'automatic', type = 'toggle', label = '自动播放', default = true,
         description = '按任务条件自动播放，与手动试听独立。'}
    }
    local values = ctx and ctx.settings or {}
    local fallback, complete = {}, true
    local sliders_migrated, toggles_migrated = true, true
    for _, spec in ipairs(specifications) do
        local id = option_ids[spec.key]
        local existing = option_api and option_call(option_api.get, id)
        local option = {type = spec.type, label = spec.label, mod = '增援耗尽自动播放雨爱',
            mod_id = ctx and ctx.id or 'rainie_love_mdl', description = spec.description,
            min = spec.min, max = spec.max, step = spec.step, default = spec.default}
        if option_api and option_call(option_api.register_option, id, option) == true then
            registered[spec.key] = id
            local marker = spec.type == 'slider' and 'mdl_sliders_migrated' or 'mdl_toggles_migrated'
            local old = values[spec.key]
            local valid = spec.type == 'toggle' and type(old) == 'boolean'
                or spec.type == 'slider' and type(old) == 'number' and old == old and old >= spec.min and old <= spec.max
            if not values[marker] and existing == nil and valid then
                if option_call(option_api.set, id, old) ~= true then
                    if spec.type == 'slider' then sliders_migrated = false else toggles_migrated = false end
                end
            end
        else
            complete = false
            if spec.type == 'slider' then sliders_migrated = false else toggles_migrated = false end
            fallback[#fallback + 1] = {key = spec.key, type = spec.type == 'slider' and 'number' or spec.type,
                label = spec.label, min = spec.min, max = spec.max, step = spec.step, default = spec.default}
            report('OPTION_NATIVE_FALLBACK ' .. spec.key)
        end
    end
    if option_api and sliders_migrated then values.mdl_sliders_migrated = true end
    if option_api and toggles_migrated then values.mdl_toggles_migrated = true end
    definition.options = fallback
    -- Retry partial failures as well as an API arriving after enable.
    if not complete then option_retry = clock + 5 else option_retry = math.huge end
end
local function set_preview(value)
    if preview ~= value then
        preview, preview_reported = value, false
        report('PREVIEW ' .. tostring(value))
    end
    if context and type(context.settings) == 'table' then context.settings.preview = value end
    if option_api and registered.preview then option_call(option_api.set, registered.preview, value) end
end
local function settings(ctx)
    local values = ctx and ctx.settings or {}
    if option_api then
        for key, id in pairs(registered) do
            local value = option_call(option_api.get, id)
            if (key == 'preview' or key == 'automatic') and type(value) == 'boolean'
                or (key == 'volume' or key == 'fade_out') and type(value) == 'number' then values[key] = value end
        end
    end
    set_preview(values.preview == true)
    automatic = values.automatic ~= false
    if not automatic then wanted = false end
    local next_volume = tonumber(values.volume) or 50
    if next_volume ~= next_volume or math.abs(next_volume) == math.huge then next_volume = 50 end
    next_volume = math.max(0, math.min(100, next_volume))
    volume = next_volume
    local value = tonumber(values.fade_out) or 1
    if value ~= value or math.abs(value) == math.huge then value = 1 end
    fade_out = math.max(1, math.min(30, value))
end
local function close()
    active, wanted = false, false
    unsubscribe()
    if audio then audio.close(); audio = nil end
    set_preview(false)
    last_hub, state = nil, Policy.new()
    option_api, registered = nil, {}
end
local function sample()
    local hub = rawget(_G, 'HD2Data')
    if hub ~= last_hub then
        unsubscribe()
        last_hub, state, event_retry = hub, Policy.new(), 0
        wanted = false
        report('HUB_CHANGED reset_policy=true')
    end
    local ending_subscription = subscriptions.ended
    if type(ending_subscription) == 'table' and type(ending_subscription.active) == 'function' then
        local ok, enabled = pcall(ending_subscription.active, ending_subscription)
        if not ok or enabled == false then unsubscribe() end
    end
    if type(hub) == 'table' and type(hub.on) == 'function' and not subscriptions.ended and clock >= event_retry then
        event_retry = clock + 5
        local ok, subscription = pcall(hub.on, 'mission_ended', function(event)
            if not active or hub ~= last_hub then return end
            local epoch = type(event) == 'table' and event.mission or nil
            if Policy.finish(state, epoch) then
                if wanted then report('AUTO_STOP reason=MISSION_ENDED_EVENT') end
                wanted = false
                set_preview(false)
                report('MISSION_ENDED_EVENT epoch=' .. tostring(epoch))
            end
        end, {owner = 'rainie_love_mdl', id = 'mission_end'})
        if ok and type(subscription) == 'table' then subscriptions.ended = subscription
        else report('MISSION_EVENT_UNAVAILABLE polling_fallback=true') end
    end
    local mission, snapshot, reason = Data.sample(hub)
    local policy_reason
    local was_active = state.active
    local previous = wanted
    local condition
    condition, policy_reason = Policy.observe(state, mission, snapshot, 0.25)
    wanted = automatic and condition
    if not automatic then policy_reason = 'AUTOMATIC_DISABLED' end
    if wanted ~= previous then
        report((wanted and 'AUTO_START' or 'AUTO_STOP') .. ' reason=' .. tostring(policy_reason))
    end
    if was_active and not state.active then set_preview(false) end

end
definition = {
    name = '增援耗尽自动播放雨爱',
    version = '0.3.2',
    author = '2375120981',
    description = '增援耗尽且仅剩一人存活时播放雨爱，每次触发从头开始。',
    options = {},
    on_enable = function(ctx)
        close()
        context, clock, next_sample = ctx, 0, 0
        last_audio_status = nil
        connect_options(ctx)
        settings(ctx)
        set_preview(false)
        audio = Audio.new(format, content, report)
        active = true
        if ctx and type(ctx.on_cleanup) == 'function' then ctx.on_cleanup(close) end
        report('ENABLE v0.3.2 no_ffi=true no_global_hooks=true')
    end,
    on_setting = function(ctx, key, value)
        if ctx and ctx.settings then ctx.settings[key] = value end
        if option_api and registered[key] then option_call(option_api.set, registered[key], value) end
        settings(ctx)
        if key == 'automatic' then
            automatic = value ~= false
            if ctx and ctx.settings then ctx.settings.automatic = automatic end
            if not automatic then
                if wanted then report('AUTO_STOP reason=AUTOMATIC_DISABLED') end
                wanted = false
            end
        end
        if key == 'preview' then set_preview(value == true) end

    end,
    on_update = function(ctx, dt)
        if not active then return end
        local seconds = tonumber(dt) or 0
        if seconds ~= seconds or seconds < 0 then seconds = 0 end
        seconds = math.min(seconds, 0.25)
        clock = clock + seconds
        if clock >= option_retry or (option_api and rawget(_G, 'ModOptionsMenu') ~= option_api) then connect_options(ctx) end
        settings(ctx)
        if clock >= next_sample then next_sample = clock + 0.25; sample() end
        local status = audio.update(seconds, wanted or preview, volume, fade_out)
        if preview and status:sub(1, 12) == 'AUDIO_FAILED' then set_preview(false) end
        if preview and not preview_reported and status == 'AUDIO_PLAYING' then
            preview_reported = true
            report('PREVIEW_PLAYING loop=true')
        end
        if status ~= last_audio_status then last_audio_status = status; report(status) end
    end,
    on_disable = function() close(); report('DISABLE') end
}

return definition
